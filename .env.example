# Export these variables before starting the Go process.
# start.sh does not implicitly load .env files.
GATEWAY_MODEL_BASE_URL=https://api.openai.com/v1
GATEWAY_MODEL=gpt-6-luna
GATEWAY_MODEL_API_KEY=

# Optional Pi coding runtime command (default: pi on PATH).
# Pi uses its own model/login configuration; maintenance model is independent of routing.
# GATEWAY_PI_COMMAND=/absolute/path/to/pi

# Generated code runs in Docker by default; no implicit host fallback.
# GATEWAY_EXECUTION_MODE=docker
# GATEWAY_SANDBOX_IMAGE=node@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da
# Additional model credential variable names for the trusted Pi process only.
# GATEWAY_PI_ENV=MY_MODEL_API_KEY

# Required for non-loopback listening. See examples/access.json.
# GATEWAY_AUTH_FILE=/absolute/path/to/access.json
# GATEWAY_ADMIN_TOKEN=<random-token-at-least-24-bytes>
# GATEWAY_READER_TOKEN=<different-random-token-at-least-24-bytes>
# GATEWAY_PUBLIC_URL=https://gateway.example.com
# GATEWAY_TRUSTED_ORIGINS=https://admin.example.com

# The named secret is referenced in repository.webhook_secret_env.
# SOURCE_WEBHOOK_SECRET=<random-webhook-secret>
# Downstream API credentials stay in the gateway environment.
# GITLAB_TOKEN=<read-only-gitlab-token>
