#!/usr/bin/env sh
# lefthook pre-commit helper: format check and incremental lint for staged Go files.
# Usage: scripts/precommit-go fmt|lint <staged .go files...>
# Bypass in emergencies with LEFTHOOK=0 (see .agents/skills/git-workflow/SKILL.md).
set -eu

pinned=v2.15.0
mode=${1:-}
[ $# -gt 0 ] && shift
[ $# -gt 0 ] || exit 0

lint=$(command -v golangci-lint 2>/dev/null || true)
if [ -z "$lint" ] && [ -x "$(go env GOPATH)/bin/golangci-lint" ]; then
  lint="$(go env GOPATH)/bin/golangci-lint"
fi
if [ -z "$lint" ]; then
  echo "golangci-lint not found. Install the pinned version:" >&2
  echo "  go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@$pinned" >&2
  exit 1
fi

case "$mode" in
fmt)
  if ! "$lint" fmt -d "$@"; then
    echo >&2
    echo "Go files above are not gofmt/goimports clean. Run 'golangci-lint fmt' (path: $lint), re-stage, and commit again." >&2
    exit 1
  fi
  ;;
lint)
  # Only packages containing staged files; only issues introduced since HEAD.
  pkgs=$(for f in "$@"; do dirname "$f"; done | sort -u | sed 's|^|./|')
  # shellcheck disable=SC2086
  "$lint" run --new-from-rev=HEAD $pkgs
  ;;
*)
  echo "usage: $0 fmt|lint <files...>" >&2
  exit 2
  ;;
esac
